---
import Default from '@astrojs/starlight/components/Footer.astro';
import type { Props } from '@astrojs/starlight/props';
import pkg from '../../package.json';
---

<Default {...Astro.props}>
  <slot />
</Default>

<div style="text-align: center; margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--sl-color-hairline); font-size: var(--sl-text-sm); color: var(--sl-color-gray-3);">
  &copy; {new Date().getFullYear()} Live Production Exchange &bull; Version {pkg.version}
</div>
